Complete the Queue class in Python using a list. Add enqueue(), dequeue(), peek(), and size() methods. Follow FIFO (First In, First Out). Keep the code short, simple, and beginner-friendly.

CODE:

class Queue:
    def __init__(self):
        self.items = []

    def enqueue(self, item):
        self.items.append(item)

    def dequeue(self):
        if self.items:
            return self.items.pop(0)
        return None

    def peek(self):
        if self.items:
            return self.items[0]
        return None

    def size(self):
        return len(self.items)


if __name__ == "__main__":
    queue = Queue()
    queue.enqueue(10)
    queue.enqueue(20)

    print("Front element:", queue.peek())
    print("Dequeued:", queue.dequeue())
    print("Queue size:", queue.size())


